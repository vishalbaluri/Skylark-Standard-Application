<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <RadioGroup
        android:id="@+id/radioGroupDateTimeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioAutomatic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Automatic Date/Time"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/radioNone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="No Date/Time"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/radioManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:text="Manual Date/Time"
            android:textSize="14sp" />

    </RadioGroup>

    <!-- Only usable when "Manual Date/Time" is selected -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:orientation="vertical">

        <CheckBox
            android:id="@+id/checkboxIncludeDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date" />

        <CheckBox
            android:id="@+id/checkboxIncludeTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time" />

    </LinearLayout>

</LinearLayout>